# Backend settings — copy to backend/.env (git-ignored). Every key is optional; these are the defaults
# the code falls back to (see app/core/config.py), so this file doubles as the reference.

ENV=dev
DEBUG=true

# --- database ---
# PostgreSQL is the target. For a zero-dependency laptop run, SQLite works for the UI and the tests:
#   DATABASE_URL=sqlite+aiosqlite:///./dev.db
DATABASE_URL=postgresql+asyncpg://broker:broker@localhost:5432/broker_hub
# used only by the pytest suite (integration-marked tests skip when it is not a Postgres URL)
DATABASE_URL_TEST=sqlite+aiosqlite:///./dev_test.db
DB_ECHO=false

# --- auth ---
# REQUIRED when ENV=prod: >= 32 chars, otherwise startup refuses to boot
JWT_SECRET=dev-only-insecure-secret-change-me
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=14
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300

# --- cors ---
CORS_ORIGINS=["http://localhost:5173"]

# --- storage for recordings / attachments: local | s3 ---
STORAGE_BACKEND=local
STORAGE_DIR=/tmp/broker-hub-objects
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=broker-hub
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
RECORDING_SIGNED_URL_TTL_SECONDS=120
RECORDING_RETENTION_DAYS=180

# --- channel drivers: sim (dev/test only, enables /api/v1/dev/sim) | live ---
# R9: `ENV=prod` forces `live`, and an explicit `sim` there fails the boot. Simulation exists only in a
# dev/test process; the simulator routes are not mounted in production at all.
# This is only the *fallback*. A provider saved on the settings screen (/settings) decides with its own
# live switch, whatever is written here (ADR-016 §1) — that is the normal way to go live, not this file.
INTEGRATIONS_DRIVER=sim
# Encrypts the credentials saved from that screen. A Fernet key, or any passphrase >=16 chars:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Empty in development => derived from JWT_SECRET. REQUIRED when ENV=prod, or the app refuses to boot.
SECRETS_ENCRYPTION_KEY=
# while rotating the key above, the retired one (empty otherwise)
SECRETS_ENCRYPTION_KEY_OLD=
# Environment fallbacks for the same fields — used only while no row is saved, and never returned by an API.
WHATSAPP_VERIFY_TOKEN=dev-verify-token
WHATSAPP_APP_SECRET=dev-app-secret
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Mobile phone calls (R9): a call to a mobile number the platform owns, delivered by a VoIP/mobile-calls
# gateway that signs its webhook (X-Call-Signature). `twilio` is the documented live dialect; `generic` is
# the plain JSON contract. In production this secret is required, or the boot refuses (no simulator).
TELEPHONY_WEBHOOK_SECRET=dev-telephony-secret
TELEPHONY_PROVIDER=twilio
TELEPHONY_WEBHOOK_URL=
TELEPHONY_API_KEY=
AI_ENABLED=false
# Origin the settings screen prints as the callback URL for Meta / the mobile-calls provider
# (must be reachable by them).
PUBLIC_BASE_URL=http://localhost:5173

# --- celery ---
REDIS_URL=redis://localhost:6379/0
# true keeps tasks in-process so the stack runs without a worker; set false with a real broker
CELERY_TASK_ALWAYS_EAGER=true

# --- messaging (mailpit in the local stack: smtp://mailpit:1025) ---
SMTP_URL=smtp://localhost:1025
# Set these to override the host/port in SMTP_URL (the settings screen edits exactly these two).
SMTP_HOST=
SMTP_PORT=0
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=none
SMTP_FROM_NAME=Broker Hub
EMAIL_FROM=no-reply@brokerhub.local
SMTP_REPLY_TO=

# --- metrics ---
# empty: /metrics is served only while DEBUG=true. Set a token to expose it to a scraper anywhere.
METRICS_TOKEN=

# --- seed ---
# the one demo password for every seeded account; override before seeding anything you do not control
SEED_PASSWORD=Br0kerHub!2026

# --- SLA clock (the sla_policies table wins per priority) ---
WORKDAY_START=09:00
WORKDAY_END=18:00
# 4 = Friday, 5 = Saturday (Egyptian weekend)
WEEKEND_DAYS=[4,5]
TIMEZONE=Africa/Cairo
REPLY_THREAD_WINDOW_MINUTES=240
