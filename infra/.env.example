# Copy to infra/.env and adjust. `docker compose` reads it automatically for this project dir.

# local demo stack runs the simulator so inbound WhatsApp/calls can be produced from /dev/sim.
# flip to "live" together with the vendor credentials below — never ship "sim" to production.
# Since ADR-016 the normal path is the settings screen (/settings), whose `is_live` switch beats this
# value in both directions: these variables are the fallback used while no provider row is saved yet.
# dev/test only; ENV=prod forces live and refuses sim (R9)
INTEGRATIONS_DRIVER=sim

S3_BUCKET=brokerhub
S3_ACCESS_KEY=broker
S3_SECRET_KEY=broker-secret

# REQUIRED in any shared environment: openssl rand -hex 32
JWT_SECRET=change-me-in-any-shared-environment-0123456789

# Encrypts the integration credentials saved from the settings screen. A Fernet key
# (`python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`) or any
# passphrase >=16 chars. Empty is allowed only outside production, where it is derived from JWT_SECRET;
# with ENV=prod an empty value stops the API from booting — that failure is the point (ADR-016 §2).
SECRETS_ENCRYPTION_KEY=
# while rotating the key above, the retired one (empty otherwise)
SECRETS_ENCRYPTION_KEY_OLD=

DEBUG=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# mailpit (dev mail sink) — UI on 8025, SMTP on 1025. Backend uses smtp://mailpit:1025 by default.
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_URL=smtp://mailpit:1025
EMAIL_FROM=no-reply@brokerhub.local
# The settings screen edits exactly these two; leave them empty to follow SMTP_URL instead (one truth).
SMTP_HOST=
SMTP_PORT=0
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=none
SMTP_FROM_NAME=Broker Hub
SMTP_REPLY_TO=

# scrape guard for GET /metrics: leave empty in development, set a token for any shared environment
METRICS_TOKEN=

# host ports (change these if something else already owns them)
WEB_PORT=5173
API_PORT=8000
PG_PORT=5432
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Origin Meta / the PBX are told to call back to; it is printed as-is on the settings screen, so a deploy
# behind a reverse proxy must set its public URL here or the copy-paste value will be wrong.
PUBLIC_BASE_URL=http://localhost:5173

# --- live drivers (fallbacks; the saved provider row wins over each of these) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# mobile phone calls provider (twilio = documented live dialect, or generic)
TELEPHONY_PROVIDER=twilio
TELEPHONY_WEBHOOK_SECRET=
TELEPHONY_API_KEY=

# the one demo password for every seeded account (backend: `python -m app.seed`)
SEED_PASSWORD=Br0kerHub!2026
