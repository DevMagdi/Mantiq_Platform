# Mantiq — production environment for `infra/docker-compose.prod.yml`.
#
#   cp infra/.env.prod.example infra/.env.prod
#   chmod 600 infra/.env.prod
#   # fill in every `CHANGE-ME`, then:
#   docker compose -f infra/docker-compose.prod.yml --env-file infra/.env.prod up -d
#
# The API validates this file at boot (ENV=prod in the compose). If one required value is missing or
# weak, the stack refuses to start and names every problem in a single error — that is the intended
# behaviour, not a bug to work around by relaxing a setting.
#
# Nothing here has a usable default. `:?` in the compose makes an unset value a hard failure instead of
# an empty string that fails later, at the first webhook.

# --- required ----------------------------------------------------------------------------------
# openssl rand -hex 32   (>= 32 chars, and never a value published in the repository)
JWT_SECRET=CHANGE-ME-openssl-rand-hex-32
# Encrypts the integration credentials saved from /settings.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=CHANGE-ME-fernet-key-or-32-char-passphrase
# only while rotating the key above
SECRETS_ENCRYPTION_KEY_OLD=

POSTGRES_USER=mantiq
POSTGRES_PASSWORD=CHANGE-ME-strong-db-password
POSTGRES_DB=mantiq
# Note the host: `postgres` is the service name on the compose network.
DATABASE_URL=postgresql+asyncpg://mantiq:CHANGE-ME-strong-db-password@postgres:5432/mantiq

# The https origin(s) of the SPA. No wildcard, no localhost, no http:// — the API refuses to boot.
CORS_ORIGINS=https://app.example.com
# Public origin used to render webhook callback URLs for copy-paste (Meta / the PBX call this).
PUBLIC_BASE_URL=https://app.example.com

# Verified sender address: notifications, SLA warnings and reminders are sent from it.
EMAIL_FROM=no-reply@example.com

# --- TLS ---------------------------------------------------------------------------------------
# Directory holding fullchain.pem + privkey.pem (a Let's Encrypt live/ directory works as-is).
TLS_CERT_DIR=./certs
WEB_PORT=80
WEB_TLS_PORT=443

# --- object storage ----------------------------------------------------------------------------
# s3 is the default. Leave S3_ENDPOINT_URL empty for AWS; set it for MinIO / R2 / Wasabi.
STORAGE_BACKEND=s3
S3_BUCKET=CHANGE-ME-bucket
S3_ACCESS_KEY=CHANGE-ME
S3_SECRET_KEY=CHANGE-ME
S3_ENDPOINT_URL=
S3_REGION=

# Durable local disk instead of S3 (must NOT be /tmp):
# STORAGE_BACKEND=local
# STORAGE_DIR=/srv/objects

# --- mail relay --------------------------------------------------------------------------------
# Either one URL…
SMTP_URL=smtp+tls://user:password@smtp.example.com:587
# …or the discrete fields, which win over the URL when SMTP_HOST is set.
SMTP_HOST=
SMTP_PORT=0
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=starttls
SMTP_FROM_NAME=Mantiq
SMTP_REPLY_TO=

# --- live channels (the provider row saved on /settings wins over these) ------------------------
INTEGRATIONS_DRIVER=live
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
TELEPHONY_PROVIDER=twilio
TELEPHONY_WEBHOOK_SECRET=
TELEPHONY_API_KEY=
TELEPHONY_WEBHOOK_URL=

# --- optional overrides (defaults are correct for a single-host stack) ---------------------------
# Point these at a managed Redis / a different database once the stack outgrows one box.
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
# `strict` if the SPA and the API share one site; `lax` is the default and is what the SPA expects.
COOKIE_SAMESITE=lax

# --- capacity / operations ---------------------------------------------------------------------
API_WORKERS=2
WORKER_CONCURRENCY=4
REDIS_MAXMEMORY=512mb
# Bearer token for GET /metrics; empty means nobody can scrape (fail-closed).
METRICS_TOKEN=
# One proxy hop (this nginx) in front of the API.
TRUST_HOPS=1

# --- not set here on purpose -------------------------------------------------------------------
# DEBUG / COOKIE_SECURE / CELERY_TASK_ALWAYS_EAGER are pinned in the compose to false/true/false:
# a production container must not be one env edit away from serving tracebacks or blocking requests.
#
# SEED_PASSWORD does not belong in production either: `python -m app.seed` refuses to run under
# ENV=prod. Create the first administrator through the service layer.
